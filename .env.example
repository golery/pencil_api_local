# Absolute or relative path to the Obsidian-style vault folder
VAULT_PATH=./fixtures/vault

# HTTP port (goapi typically uses 8200)
PORT=8300

# Extra CORS origins (comma-separated). Defaults always include:
# https://pencil.golery.com, http://localhost:3000, http://127.0.0.1:3000
# CORS_ORIGINS=http://localhost:3001
